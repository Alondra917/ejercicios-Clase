size = 10

for i in range(1, size + 1):
    # Patrón A
    for j in range(i):
        print('*', end='')
    print(' ' * (size - i + 3), end='')  

    # Patrón B
    for j in range(size - i + 1):
        print('*', end='')
    print(' ' * (i + 2), end='')  

    # Patrón C
    print(' ' * (i - 1), end='')  
    for j in range(size - i + 1):
        print('*', end='')
    print(' ' * 3, end='')

    # Patrón D
    print(' ' * (size - i), end='')  
    for j in range(i):
        print('*', end='')

    print()  
